generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Provider {
  NETFLIX
}

enum VerificationStatus {
  LIVE_CHECKED
  THIRD_PARTY_LISTED
  UNVERIFIED
  LIVE_CHECK_FAILED
  RETIRED
}

enum SourceType {
  PROVIDER
  THIRD_PARTY
}

enum EvidenceType {
  THIRD_PARTY_LISTING
  OFFICIAL_MENTION
  DIRECT_PROVIDER_PAGE
}

enum ReportType {
  DOES_NOT_OPEN
  WRONG_CATEGORY
  OUTDATED
  REGION_UNAVAILABLE
  INCORRECT_DETAILS
  OTHER
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

model Category {
  id                 String             @id @default(cuid())
  provider           Provider           @default(NETFLIX)
  code               String
  name               String
  alternateNames     String[]           @default([])
  description        String?
  keywords           String[]           @default([])
  moods              String[]           @default([])
  providerUrl        String
  verificationStatus VerificationStatus @default(UNVERIFIED)
  lastVerifiedAt     DateTime?          @db.Date
  verificationRegion String?
  active             Boolean            @default(true)
  sources            CategorySource[]
  parentLinks        CategoryParent[]   @relation("ChildCategory")
  childLinks         CategoryParent[]   @relation("ParentCategory")
  reports            IssueReport[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([provider, code])
  @@index([verificationStatus, active, name])
  @@index([name])
}

model CategorySource {
  id            String       @id @default(cuid())
  categoryId    String
  url           String
  sourceType    SourceType
  evidenceType  EvidenceType
  observedAt    DateTime?    @db.Date
  observedLabel String?
  note          String?
  category      Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())

  @@index([categoryId])
}

// Parent code/name snapshots preserve source-listed parents that are not yet
// present as separate catalogue records. parentCategoryId can be linked later.
model CategoryParent {
  id               String    @id @default(cuid())
  categoryId       String
  parentCode       String
  parentName       String
  parentCategoryId String?
  category         Category  @relation("ChildCategory", fields: [categoryId], references: [id], onDelete: Cascade)
  parentCategory   Category? @relation("ParentCategory", fields: [parentCategoryId], references: [id], onDelete: SetNull)

  @@unique([categoryId, parentCode])
  @@index([parentCode])
}

model IssueReport {
  id         String       @id @default(cuid())
  categoryId String
  type       ReportType
  details    String?
  status     ReportStatus @default(OPEN)
  category   Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  reviewedAt DateTime?
  adminNote  String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([categoryId, createdAt])
}

model Admin {
  // A fixed key makes a second administrator impossible at the database layer.
  id           String   @id @default("wachoo-primary-admin")
  email        String   @unique
  passwordHash String
  authVersion  Int      @default(1)
  disabled     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
