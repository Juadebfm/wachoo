# Local defaults for docker-compose.yml. Change nothing here to use the local services.
DATABASE_URL=postgresql://wachoo:local_only@localhost:5432/wachoo?schema=public
DIRECT_URL=postgresql://wachoo:local_only@localhost:5432/wachoo?schema=public
REDIS_URL=redis://localhost:6379
APP_ORIGIN=http://localhost:5173
RATE_LIMIT_HASH_KEY=local-development-only-change-before-deployment

# Optional: TMDB API Read Access Token for poster-based genre suggestions.
# Keep the real value in apps/api/.env; never put it in the web app.
TMDB_API_READ_ACCESS_TOKEN=

# On Vercel, use a pooled database URL for DATABASE_URL and a direct URL for DIRECT_URL.
# Set these after connecting Upstash Redis through the Vercel Marketplace.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
